// LOOTACLIM — Schéma de base de données
// Base locale : SQLite (fichier dev.db). En production on passera sur PostgreSQL
// en changeant uniquement le "datasource" ci-dessous.
//
// NOTE : SQLite ne supporte pas les enums Prisma, on utilise donc des String
// avec des valeurs conventionnelles documentées (voir lib/constants.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Adresse groupée (hôte "-pooler"), utilisée par l'application à chaque requête.
  url       = env("POSTGRES_PRISMA_URL")
  // Adresse directe : "prisma migrate" ne supporte pas le regroupement de connexions.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Un MODÈLE de climatiseur (ex : RIVOLI)
model Product {
  id          String         @id @default(cuid())
  slug        String         @unique // "rivoli"
  name        String // "RIVOLI"
  description String
  powerKw     Float // 2.9
  noiseDb     Int // 46
  maxAreaM2   Int // 35
  dailyPrice  Int // en CENTIMES : 1800 = 18,00 €
  depositAmount Int          @default(0) // caution en CENTIMES, éditable en back-office
  active      Boolean        @default(true)
  images      ProductImage[]
  units       Unit[]
  bookings    Booking[]
  createdAt   DateTime       @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String // /images/rivoli-1.jpg ou URL Cloudinary plus tard
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

// Un climatiseur PHYSIQUE (un exemplaire réel de votre stock)
model Unit {
  id           String    @id @default(cuid())
  serialNumber String    @unique
  status       String    @default("AVAILABLE") // AVAILABLE | RENTED | IN_TRANSIT | MAINTENANCE | RETIRED
  notes        String? // "rayure capot arrière", etc.
  product      Product   @relation(fields: [productId], references: [id])
  productId    String
  bookings     Booking[]
}

// Un kit de calfeutrage physique — universel, pas lié à un modèle précis.
model Kit {
  id           String    @id @default(cuid())
  serialNumber String    @unique
  status       String    @default("AVAILABLE") // AVAILABLE | RENTED | MAINTENANCE | RETIRED
  notes        String?
  bookings     Booking[]
}

model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String
  lastName      String
  phone         String
  internalNotes String? // visible uniquement en back-office
  stripeCustomerId String? // id client Stripe, pour débiter la caution plus tard sans redemander la carte
  addresses     Address[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
}

model Address {
  id         String    @id @default(cuid())
  line1      String
  zip        String
  city       String
  floor      String    @default("rdc") // "rdc" | "asc" | "esc"
  accessCode String?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  bookings   Booking[]
}

model Booking {
  id          String     @id @default(cuid())
  reference   String     @unique
  customer    Customer   @relation(fields: [customerId], references: [id])
  customerId  String
  address     Address    @relation(fields: [addressId], references: [id])
  addressId   String
  product     Product    @relation(fields: [productId], references: [id])
  productId   String
  unit        Unit?      @relation(fields: [unitId], references: [id])
  unitId      String?
  kit         Kit?       @relation(fields: [kitId], references: [id])
  kitId       String?
  wantsKit    Boolean    @default(false) // coché par le client à la réservation, même si aucun kit n'a pu être affecté tout de suite
  startDate   DateTime
  endDate     DateTime
  status      String     @default("AWAITING_PAYMENT")
  // AWAITING_PAYMENT | PENDING | CONFIRMED | DELIVERED | RETURNED | CANCELLED
  checkoutExpiresAt DateTime? // fin de validité de la session Stripe Checkout, tant que status = AWAITING_PAYMENT
  subtotal    Int
  discount    Int        @default(0)
  deliveryFee Int        @default(2900)
  floorFee    Int        @default(0)
  total       Int
  depositAmount        Int    @default(0) // caution en centimes, figée au moment de la réservation
  depositStatus         String @default("NONE")
  // NONE | HELD | FAILED | RELEASED | CAPTURED
  capturedAmount        Int?   // montant réellement encaissé si CAPTURED
  depositId             String? // id du PaymentIntent Stripe de la caution
  paymentId             String? // id du PaymentIntent Stripe de la location
  stripePaymentMethodId String? // moyen de paiement enregistré au paiement, réutilisé pour la caution
  deliveries  Delivery[]
  createdAt   DateTime   @default(now())

  @@index([productId])
  @@index([unitId])
}

// Une livraison OU une reprise
model Delivery {
  id        String   @id @default(cuid())
  type      String // DROPOFF (livraison) | PICKUP (reprise)
  date      DateTime
  timeSlot  String // créneau de 2 h — voir TIME_SLOTS dans lib/constants.js
  status    String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | DONE | FAILED
  proofUrl  String? // photo/signature (plus tard)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
}

// Réponse à l'enquête de marché affichée à l'arrivée sur le site.
// Champs en String comme le reste du projet : la convention date de SQLite,
// qui n'avait pas d'énumérations, et elle a été conservée par cohérence.
// Aucune donnée sensible : ni nom, ni adresse précise, ni revenu.
model SurveyResponse {
  id              String   @id @default(cuid())
  surface         String
  location        String // arrondissement ou commune, saisie libre
  housing         String
  duration        String
  priceRange      String
  currentSolution String
  blocker         String
  ageRange        String
  email           String? // facultatif : sert de liste d'attente pour le lancement
  createdAt       DateTime @default(now())

  @@index([createdAt])
}
