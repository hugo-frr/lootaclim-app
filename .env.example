# Copiez ce fichier en ".env" et remplissez les deux valeurs.
# Le fichier .env est local : il n'est jamais publié ni versionné.

# Base de données PostgreSQL (Neon, via le catalogue Vercel).
# Ces valeurs se copient depuis l'onglet ".env.local" de la base, dans le
# tableau de bord Vercel. En production, Vercel les injecte automatiquement.
#   POSTGRES_PRISMA_URL      = hôte groupé ("-pooler"), utilisé par l'application
#   POSTGRES_URL_NON_POOLING = hôte direct, exigé par "prisma migrate"
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Mot de passe de connexion au back-office /admin
ADMIN_PASSWORD=

# Clé de signature des sessions — générer avec :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Paiement Stripe — voir la section "💳 Paiement Stripe" du README pour la
# marche à suivre complète (créer le compte, récupérer les clés de test).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secret partagé pour protéger la tâche planifiée de pose de caution
# (/api/cron/deposits) — générer comme SESSION_SECRET :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Emails de confirmation (client + notification admin), envoyés via la boîte
# mail LWS de lootaclim.fr — voir la section "📧 Emails de confirmation" du
# README pour la marche à suivre complète. Sans ces valeurs, l'envoi est
# simplement ignoré (le reste du site continue de fonctionner).
SMTP_HOST=mail.lootaclim.fr
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LOOTACLIM <votre-adresse@lootaclim.fr>"
ADMIN_NOTIFICATION_EMAIL=
